# Bundled Postgres (default). Remove this line and set DATABASE_URL to use an existing DB.
COMPOSE_PROFILES=bundled-db
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# DATABASE_URL=postgres://user:pass@host:5432/tenet

TENET_API_TOKEN=generate-with-openssl-rand-hex-32
DASHBOARD_PASSWORD=pick-a-short-password-you-can-remember
TENET_PORT=8787
TZ=UTC

# Optional: publish public README badges through badge-worker/
TENET_BADGE_WORKER_URL=
TENET_BADGE_WRITE_TOKEN=
TENET_PUBLIC_DASHBOARD_URL=
